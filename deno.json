{
  "nodeModulesDir": "none",
  "imports": {
    "@deno/oidc": "jsr:@deno/oidc@0.1.0",
    "unpdf": "npm:unpdf@1.8.1"
  },
  "deploy": {
    "install": "deno install --frozen --entrypoint deno/google-api-proxy/main.ts",
    "runtime": {
      "type": "dynamic",
      "entrypoint": "deno/google-api-proxy/main.ts"
    },
    "org": "halh0328",
    "app": "toshi-wif-test"
  },
  "tasks": {
    "check:google-proxy": "deno check deno/google-api-proxy/main.ts",
    "test:google-proxy": "deno test --frozen --allow-env --allow-read tests/deno-wif.test.mjs",
    "serve:google-proxy": "deno run --allow-env --allow-net deno/google-api-proxy/main.ts"
  }
}
